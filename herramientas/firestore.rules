rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas de Google pueden leer y escribir. Para dar acceso a alguien más, agrega su correo.
    function permitido() {
      return request.auth != null && request.auth.token.email_verified
        && request.auth.token.email in ['TU_CORREO@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
